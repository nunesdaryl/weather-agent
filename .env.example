# Azure AI Foundry -> your model deployment page
AZURE_AI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/openai/v1
AZURE_AI_API_KEY=<your key>
AZURE_AI_MODEL=<your deployment name>

# Default agent for API calls that don't say which (the UI always says):
# loop = the hand-written loop in agent.py, graph = LangGraph in agent_graph.py
AGENT_IMPL=loop
